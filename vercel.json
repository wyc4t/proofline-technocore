{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "archive-data": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Slackbot|Discordbot|LinkedInBot|TelegramBot|WhatsApp|Mastodon|Bluesky|Cardyb|Embedly|redditbot|Applebot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/cases",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Slackbot|Discordbot|LinkedInBot|TelegramBot|WhatsApp|Mastodon|Bluesky|Cardyb|Embedly|redditbot|Applebot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/share?view=cases"
    },
    {
      "source": "/daily",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Slackbot|Discordbot|LinkedInBot|TelegramBot|WhatsApp|Mastodon|Bluesky|Cardyb|Embedly|redditbot|Applebot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/share?view=digest"
    },
    {
      "source": "/",
      "destination": "/site-overview"
    },
    {
      "source": "/cases",
      "destination": "/site-cases"
    },
    {
      "source": "/daily",
      "destination": "/site-daily"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "case"
        }
      ],
      "destination": "/cases",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/cases",
      "permanent": false
    },
    {
      "source": "/digest",
      "destination": "/daily",
      "permanent": false
    }
  ]
}
