{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "archive-data": false
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Slackbot|Discordbot|LinkedInBot|TelegramBot|WhatsApp|Mastodon|Bluesky|Cardyb|Embedly|redditbot|Applebot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/digest",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|Slackbot|Discordbot|LinkedInBot|TelegramBot|WhatsApp|Mastodon|Bluesky|Cardyb|Embedly|redditbot|Applebot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/share?view=digest"
    },
    {
      "source": "/digest",
      "destination": "/daily"
    },
    {
      "source": "/",
      "destination": "/app"
    }
  ]
}
